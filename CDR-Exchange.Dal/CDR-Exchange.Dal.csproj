        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="7.0.1" />
    </ItemGroup>


    <ItemGroup>
      <ProjectReference Include="..\CDR-Exchange.Domain\CDR-Exchange.Domain.csproj" />
    </ItemGroup>

